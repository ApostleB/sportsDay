<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jua&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<% const manageArea = area === 'manage' || area === 'admin'; %>
<body class="<%= [wide ? 'wide' : '', manageArea ? 'area-manage' : ''].filter(Boolean).join(' ') %>">
  <% if (manageArea) { %><%- include('partials/manage-bar') %><% } %>
  <main class="container"><%- body %></main>
</body>
</html>
