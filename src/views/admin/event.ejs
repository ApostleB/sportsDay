<p><a class="btn btn-small" href="/admin">목록으로</a></p>
<h1 class="title"><%= event.title %></h1>
<%- include('../partials/alert') %>
<section class="card stack">
  <h2>정보</h2>
  <p>회차 <%= event.round_no %> · 상태 <%= statusLabel(event.status) %> · 인증코드 <strong><%= event.auth_code %></strong> · 코드 <strong><%= event.slug %></strong></p>
  <p class="copy"><%= inviteUrl %></p>
  <div><a class="btn" href="/e/<%= event.slug %>/manage">생성자 화면으로 들어가기</a></div>
</section>
<section class="card stack">
  <h2>생성자 PIN 재설정</h2>
  <form method="post" action="/admin/events/<%= event.id %>/creator-pin" class="row">
    <input name="pin" inputmode="numeric" pattern="\d{6}" maxlength="6" required placeholder="새 6자리 PIN" style="width: 10em">
    <button class="btn btn-small">재설정</button>
  </form>
</section>
<section class="card stack" id="manito">
  <h2>마니또</h2>
  <p>상태 <strong><%= manitoStageLabel(manito.stage) %></strong> · 순환 <%= manito.size %>명 · 확인 <%= manito.acknowledgedCount %>명 · 맵 <%= manito.locked ? '잠김' : '열림' %></p>
  <% if (manito.cycle.length) { %>
  <p class="copy"><%= manito.cycle.join(' → ') %> → <%= manito.cycle[0] %></p>
  <% } else if (manito.stage !== 'none') { %>
  <p class="muted">이어진 순환이 없습니다.</p>
  <% } %>
  <form method="post" action="/admin/events/<%= event.id %>/manito-lock">
    <input type="hidden" name="locked" value="<%= manito.locked ? '0' : '1' %>">
    <button class="btn btn-small"><%= manito.locked ? '잠금 해제' : '맵 잠그기' %></button>
  </form>
  <p class="hint">잠그면 공개된 전체 맵만 숨겨집니다. 각자 자기 마니또 확인은 계속 됩니다. 이름은 항상 가려서 보여 줍니다.</p>
</section>
<section class="card stack" id="join">
  <h2>참가 마감</h2>
  <p><strong><%= event.join_closed ? '참가 마감됨' : '참가 받는 중' %></strong></p>
  <form method="post" action="/admin/events/<%= event.id %>/join-closed">
    <input type="hidden" name="closed" value="<%= event.join_closed ? '0' : '1' %>">
    <button class="btn btn-small"><%= event.join_closed ? '마감 풀기' : '참가 마감' %></button>
  </form>
</section>
<section class="card table-wrap">
  <h2>참가자 (<%= list.length %>명)</h2>
  <table>
    <thead><tr><th>이름</th><th>출석</th><th>등록일</th><th>PIN 재설정</th></tr></thead>
    <tbody>
      <% list.forEach((p) => { %>
      <tr>
        <td><%= p.name %></td>
        <td><%= p.attendance === 'present' ? '출석' : '결석' %></td>
        <td><%= fmtDateTime(p.created_at) %></td>
        <td>
          <form method="post" action="/admin/events/<%= event.id %>/participants/<%= p.id %>/pin" class="row">
            <input name="pin" inputmode="numeric" pattern="\d{4}" maxlength="4" required placeholder="새 4자리" style="width: 7em">
            <button class="btn btn-small">재설정</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<section class="card stack">
  <h2>운동회 삭제</h2>
  <p class="hint">되돌릴 수 없습니다. 확인을 위해 운동회 코드 <strong><%= event.slug %></strong>를 입력하세요.</p>
  <form method="post" action="/admin/events/<%= event.id %>/delete" class="row">
    <input name="confirm" required style="width: 10em">
    <button class="btn btn-small btn-danger">삭제</button>
  </form>
</section>
