<% const navItems = [['', '대시보드'], ['/event', '운동회 정보'], ['/participants', '참가자'], ['/teams', '팀 설정'], ['/groups', '그룹'], ['/draw', '팀 뽑기'], ['/manito', '마니또'], ['/polls', '투표'], ['/announcements', '공지'], ['/schedules', '시간표']]; %>
<details class="manage-menu">
  <summary>☰ 메뉴</summary>
  <nav class="manage-menu-list" aria-label="관리 메뉴">
    <% navItems.forEach(([path, label]) => { const on = path === '' ? (navPath === '/' || navPath === '/created') : (navPath === path || navPath.startsWith(path + '/')); %>
    <a href="<%= base %>/manage<%= path %>"<%- on ? ' aria-current="page"' : '' %>><%= label %></a>
    <% }) %>
  </nav>
</details>
