<header class="topbar">
  <a class="brand" href="<%= base %>/home"><span><%= event.title %></span></a>
  <div class="row" style="flex-wrap: nowrap">
    <% if (isCreator) { %><a class="btn btn-small" href="<%= base %>/manage">관리 페이지</a><% } else { %><a class="btn btn-small btn-ghost" href="<%= base %>/manage/unlock">생성자 입장</a><% } %>
    <details class="me">
      <summary class="chip"><%= participant.name %> ▾</summary>
      <div class="menu">
        <form method="post" action="<%= base %>/logout"><button class="btn btn-small btn-danger">로그아웃</button></form>
      </div>
    </details>
  </div>
</header>
